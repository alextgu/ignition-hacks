# SnapPlan local secrets. Copy to .env and fill in values.
# Never commit real keys. They are gitignored via .env.

# --- ElevenLabs (venue-calling voice agent) ---
# Create a User API key (not a service-account key) at:
# https://elevenlabs.io/app/settings/api-keys
#
# Key type: User API key, Restricted
# Required permissions:
#   - Agents: Write   (convai_read + convai_write)
#   - Voices: Read    (voices_read)
# Optional:
#   - Text to Speech  (text_to_speech)
#   - User: Read      (user_read)
# Leave expiry as Never for the hackathon, or 30 days if you prefer.
# Copy the key once — ElevenLabs only shows it at creation.
ELEVENLABS_API_KEY=

# Agents dashboard: https://elevenlabs.io/app/agents
ELEVENLABS_AGENT_ID=

# Phone number ID from ElevenLabs after linking Twilio for outbound calls.
# Dashboard: https://elevenlabs.io/app/agents/phone-numbers
ELEVENLABS_PHONE_NUMBER_ID=

# Shared secret from the ElevenLabs post-call webhook settings.
# Used to verify the ElevenLabs-Signature HMAC header.
ELEVENLABS_WEBHOOK_SECRET=

# E.164 test destination only (e.g. +14155552671). Never call a real venue
# until lock-in + an explicit live booking action are wired.
ELEVENLABS_TEST_TO_NUMBER=

# --- Twilio (caller number source for ElevenLabs) ---
# SnapPlan does not place Twilio calls directly. Import these into ElevenLabs
# Telephony so outbound calls use your Twilio number, then copy the resulting
# phone-number ID into ELEVENLABS_PHONE_NUMBER_ID.
#
# Twilio Console → Account Info:
#   TWILIO_SID      = Account SID
#   TWILIO_API_KEY  = Auth Token (or API Key Secret if you create an API key)
TWILIO_SID=
TWILIO_API_KEY=

# --- World Labs / Marble (spatial-art world generation) ---
# 1. Redeem the Marble Max promo at:
#    https://marble.worldlabs.ai/account/billing?promo=<MARBLE_CODE>
# 2. Redeem the API credit promo at:
#    https://platform.worldlabs.ai/billing?promo=<API_CODE>
# 3. Create a key at https://platform.worldlabs.ai/api-keys
# Official env name is WLT_API_KEY. Requests send it as the WLT-Api-Key header.
WLT_API_KEY=
WORLD_LABS_API_KEY=

# Comma-separated web origins allowed to call the API (no trailing slash).
# Include both Base44 preview and published origins during the hackathon.
PLANIT_ALLOWED_ORIGINS=
