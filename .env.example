# SnapPlan local secrets. Copy to .env and fill in values.
# Never commit real keys. They are gitignored via .env.

# --- ElevenLabs (venue-calling voice agent) ---
# Create a User API key (not a service-account key) at:
# https://elevenlabs.io/app/settings/api-keys
#
# Key type: User API key, Restricted
# Required permissions:
#   - Agents: Write   (convai_read + convai_write)
#   - Voices: Read    (voices_read)
# Optional:
#   - Text to Speech  (text_to_speech)
#   - User: Read      (user_read)
# Leave expiry as Never for the hackathon, or 30 days if you prefer.
# Copy the key once — ElevenLabs only shows it at creation.
ELEVENLABS_API_KEY=

# Created later in the Agents dashboard: https://elevenlabs.io/app/agents
# Not needed until the booking-agent slice.
ELEVENLABS_AGENT_ID=

# Phone number ID from ElevenLabs after linking Twilio/SIP for outbound calls.
# Not needed until the booking-agent slice.
ELEVENLABS_PHONE_NUMBER_ID=

# --- World Labs / Marble (spatial-art world generation) ---
# 1. Redeem the Marble Max promo at:
#    https://marble.worldlabs.ai/account/billing?promo=<MARBLE_CODE>
# 2. Redeem the API credit promo at:
#    https://platform.worldlabs.ai/billing?promo=<API_CODE>
# 3. Create a key at https://platform.worldlabs.ai/api-keys
# Official env name is WLT_API_KEY. Requests send it as the WLT-Api-Key header.
WLT_API_KEY=
WORLD_LABS_API_KEY=

# --- Canonical names read by src/integrations/** ---
# The loaders accept the names above as aliases, so an already-filled .env
# keeps working. These are the names the modules document:
#   WORLDLABS_API_KEY                 <- also accepts WLT_API_KEY, WORLD_LABS_API_KEY
#   ELEVENLABS_AGENT_PHONE_NUMBER_ID  <- also accepts ELEVENLABS_PHONE_NUMBER_ID
# Optional tuning, all with safe defaults (see docs/*-setup.md):
# WORLDLABS_MODEL=marble-1.1
# WORLDLABS_TIMEOUT_MS=15000
# WORLDLABS_FORCE_MOCK=
# ELEVENLABS_TIMEOUT_MS=15000
# ELEVENLABS_USE_PROMPT_OVERRIDE=true
# ELEVENLABS_CALL_RECORDING_ENABLED=false
# ELEVENLABS_FORCE_MOCK=
# ELEVENLABS_MOCK_OUTCOME=
